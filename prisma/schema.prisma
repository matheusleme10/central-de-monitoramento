// Central de Monitoramento de Atualizações — Schema Prisma
// Convenções: UUID para PKs, timestamps em UTC, soft delete (deletedAt) em
// entidades de negócio, índices em FKs e colunas de busca frequente.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// RBAC — Usuários, Papéis, Permissões, Grupos
// ---------------------------------------------------------------------------

enum RoleName {
  SUPERADMIN
  ADMIN
  GESTOR
  OPERADOR
  VISUALIZADOR
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        RoleName         @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique // ex.: "project:read", "project:write"
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  email             String    @unique
  emailVerified     DateTime? @map("email_verified")
  image             String?
  passwordHash      String?   @map("password_hash") // null = login apenas via OAuth
  roleId            String    @map("role_id") @db.Uuid
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  role              Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  accounts          Account[]
  sessions          Session[]
  groupMemberships  GroupMember[]
  projectMemberships ProjectMember[]
  auditLogs         AuditLog[]
  apiTokensCreated  ApiToken[]
  invitedBy         String?            @map("invited_by") @db.Uuid
  inviter           User?              @relation("UserInvites", fields: [invitedBy], references: [id], onDelete: SetNull)
  invitees          User[]             @relation("UserInvites")

  @@index([roleId])
  @@index([deletedAt])
  @@map("users")
}

model Group {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @unique
  description String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  members     GroupMember[]

  @@map("groups")
}

model GroupMember {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

// ---------------------------------------------------------------------------
// Auth.js — Account / Session / VerificationToken (PrismaAdapter)
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Hierarquia: Projeto → Planilha → Aba → Histórico de Atualizações
// ---------------------------------------------------------------------------

model Project {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  description String?
  // Usadas pela pesquisa global (Ctrl+K); simples lista de strings, sem
  // tabela própria por não haver necessidade de metadados por tag ainda.
  tags        String[]        @default([])
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  members     ProjectMember[]
  spreadsheets Spreadsheet[]
  apiTokens   ApiToken[]
  obsidianLinks ObsidianLink[]

  @@index([deletedAt])
  @@map("projects")
}

enum ProjectAccessLevel {
  VIEWER
  EDITOR
  MANAGER
}

model ProjectMember {
  id          String             @id @default(uuid()) @db.Uuid
  projectId   String             @map("project_id") @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  accessLevel ProjectAccessLevel @default(VIEWER) @map("access_level")
  createdAt   DateTime           @default(now()) @map("created_at")

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Spreadsheet {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  spreadsheetId String    @map("spreadsheet_id") // Google Sheets ID
  name          String
  friendlyName  String?   @map("friendly_name")
  url           String
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sheets        Sheet[]

  @@unique([projectId, spreadsheetId])
  @@index([deletedAt])
  @@map("spreadsheets")
}

model Sheet {
  id            String    @id @default(uuid()) @db.Uuid
  spreadsheetId String    @map("spreadsheet_id") @db.Uuid
  gid           String // GID da aba no Google Sheets
  name          String
  friendlyName  String?   @map("friendly_name")
  url           String
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  spreadsheet   Spreadsheet   @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)
  updateEvents  UpdateEvent[]
  schedules     Schedule[]
  alerts        Alert[]
  obsidianLinks ObsidianLink[]

  @@unique([spreadsheetId, gid])
  @@index([deletedAt])
  @@map("sheets")
}

enum UpdateStatus {
  RUNNING
  SUCCESS
  ERROR
  CANCELLED
}

/**
 * Guarda apenas o status da ÚLTIMA execução de cada aba (1 linha por
 * `sheetId`) — não é mais um log histórico de todas as execuções. Decisão
 * do cliente: menos dados acumulados, só "está atualizada ou não agora".
 * `POST /api/v1/updates` faz upsert por `sheetId`, sobrescrevendo o
 * registro anterior a cada nova execução em vez de inserir uma linha nova.
 */
model UpdateEvent {
  id            String       @id @default(uuid()) @db.Uuid
  sheetId       String       @unique @map("sheet_id") @db.Uuid
  executionId   String       @map("execution_id")
  startedAt     DateTime     @map("started_at")
  finishedAt    DateTime?    @map("finished_at")
  durationMs    Int?         @map("duration_ms")
  rowsProcessed Int?         @map("rows_processed")
  status        UpdateStatus @default(RUNNING)
  message       String?
  errorCode     String?      @map("error_code")
  createdAt     DateTime     @default(now()) @map("created_at")

  sheet         Sheet        @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("update_events")
}

model Schedule {
  id               String    @id @default(uuid()) @db.Uuid
  sheetId          String    @map("sheet_id") @db.Uuid
  cronExpression   String?   @map("cron_expression")
  expectedInterval Int?      @map("expected_interval_minutes")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  sheet            Sheet     @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  // Uma aba tem no máximo um agendamento/intervalo esperado configurado.
  @@unique([sheetId])
  @@map("schedules")
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model Alert {
  id         String        @id @default(uuid()) @db.Uuid
  sheetId    String        @map("sheet_id") @db.Uuid
  type       String
  severity   AlertSeverity @default(WARNING)
  message    String
  isResolved Boolean       @default(false) @map("is_resolved")
  resolvedAt DateTime?     @map("resolved_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  sheet      Sheet         @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([sheetId, isResolved])
  @@map("alerts")
}

// ---------------------------------------------------------------------------
// Auditoria, Tokens de API, Integração Obsidian
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ApiToken {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  tokenHash  String    @unique @map("token_hash")
  // Últimos caracteres do token (não sensível) — permite identificar o
  // token na listagem sem nunca reexpor o valor completo após a criação.
  tokenPreview String  @map("token_preview")
  projectId  String?   @map("project_id") @db.Uuid
  createdById String   @map("created_by") @db.Uuid
  expiresAt  DateTime? @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy  User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([createdById])
  @@map("api_tokens")
}

enum ObsidianLinkType {
  MARKDOWN
  URI
}

model ObsidianLink {
  id        String           @id @default(uuid()) @db.Uuid
  projectId String?          @map("project_id") @db.Uuid
  sheetId   String?          @map("sheet_id") @db.Uuid
  type      ObsidianLinkType
  value     String // caminho do markdown ou URI obsidian://
  createdAt DateTime         @default(now()) @map("created_at")

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sheet     Sheet?   @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([sheetId])
  @@map("obsidian_links")
}
